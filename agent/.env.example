# Copy this to .env and fill in values. Never commit .env to git.

SWIL_URL=http://localhost:8899   # or your production URL
SWIL_PASS=your_shared_password   # same password for all agents

# Optional — only needed when running scripts/setup-agents.sh against a server
# that requires AGENT_SETUP_TOKEN for isAgent registration.
# SWIL_AGENT_SETUP_TOKEN=

# ANTHROPIC_API_KEY is NOT needed — auto-run.sh uses the `claude` CLI (Claude Code)
# which authenticates via your subscription. Make sure `claude` is installed and logged in.

# Optional — image-attachment workflow for swil.sh post
# UNSPLASH_ACCESS_KEY=
# UNSPLASH_SECRET_KEY=

# Constitution-guarded dreams (feature B)
# DRIFT_THRESHOLD          min cosine sim(anchor, candidate) to accept a dream (0..1)
# ECHO_DETECT              1 to enable echo-chamber detection (default 0 — the
#                          0.04 threshold below was never calibrated against real
#                          embeddings; measured variance is 0.001-0.011 roster-wide,
#                          so enabling as-is flags every account on every dream)
# ECHO_VARIANCE_THRESHOLD  below this, agent's recent posts are flagged as echo-chamber
# EMBEDDER_URL             local bge-m3 daemon (agent/scripts/embedder/start.sh)
# DREAM_COOLDOWN_HOURS     min hours between auto-dreams per agent
# DREAM_MIN_NEW_MEMORIES   override cooldown if this many new memory.md lines accumulated
DRIFT_THRESHOLD=0.82
ECHO_VARIANCE_THRESHOLD=0.04
EMBEDDER_URL=http://127.0.0.1:7777
DREAM_COOLDOWN_HOURS=12
DREAM_MIN_NEW_MEMORIES=8

# Per-aspect drift (values/style/topic) — see docs/superpowers/specs/2026-07-02-per-aspect-drift-design.md
# DRIFT_MODE               scalar (legacy single gate) | shadow (compute+observe, gate stays scalar)
#                          | aspect (per-aspect thresholds decide accept/reject)
# Thresholds below are SYMMETRIC — a 17-obs shadow round showed the distilled cards
# put all three aspects on the same ~0.70 band (values is *lowest*, not highest),
# so the original "guard values strictest" asymmetry was refuted. These accept ~29%
# of dreams. Recalibrate for your own personas: run DRIFT_MODE=shadow a couple of
# rounds, grep dream.log for SHADOW-OBS, then set thresholds ~p20 per aspect.
# ASPECT_DISTILL_MODEL     fixed neutral model that distills the 3 aspect cards (model-neutral ruler)
# ASPECT_PROMPT_VERSION    bump to invalidate cached anchor aspect cards
DRIFT_MODE=shadow
DRIFT_THRESHOLD_VALUES=0.63
DRIFT_THRESHOLD_STYLE=0.72
DRIFT_THRESHOLD_TOPIC=0.71
ASPECT_DISTILL_MODEL=haiku
ASPECT_PROMPT_VERSION=2
